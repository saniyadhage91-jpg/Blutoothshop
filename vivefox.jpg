html .bg-secondary { background-color: rgb(0, 34, 66); }

html .bg-blue-rebranding { background-color: rgb(0, 30, 96); }

html .b2b-search-icon-bg-blue { background-color: rgb(0, 146, 224); }

@media (min-width: 1024px) {
  html .footer-list { background-color: rgb(0, 34, 66); }
  html .footer-list.rebranding { background-color: rgb(0, 30, 96); }
  html .footer-copyright { background-color: rgb(0, 34, 66); color: rgb(255=
, 255, 255); }
  html .footer-copyright.rebranding { background-color: rgb(0, 30, 96); col=
or: rgb(255, 255, 255); }
  html .footer-wrapper { background-color: rgb(230, 241, 252); }
  html .footer-wrapper.rebranding { background-color: rgb(233, 241, 254); }
}

html .account-page-background { background: linear-gradient(rgb(0, 34, 66) =
69%, rgb(255, 255, 255) 0px); }

html .mobile-account-skeleton-title-bg { background-color: rgb(0, 34, 66); =
height: 40px; width: 60%; }

html .mobile-account-skeleton-caption-bg { background-color: rgb(0, 34, 66)=
; width: 45%; }

@media (max-width: 599px) {
  html .banner-divider { border-color: rgb(0, 34, 66); }
}

html .session-ai-popover-container { width: 367px; }

@media screen and (max-width: 576px) {
  html .session-ai-popover-container { max-width: 250px; }
}

@media screen and (max-width: 320px) {
  html .session-ai-popover-container { max-width: 200px; }
}

@media screen and (max-width: 270px) {
  html .session-ai-popover-container { max-width: 160px; }
}

html .approval-settings-heading { font-size: 1.125rem; line-height: 1.5rem;=
 }

html .row-background:hover { background: var(--color-core-white,#fff); }

@media (min-width: 37.5rem) {
  html .approval-settings-heading { font-size: 2rem; line-height: 2.5rem; }
  html .row-background:hover { background: var(--color-core-gray-10,#f1f1f2=
); }
  html .add-approver-modal-users-list { max-height: 300px; width: 552px; }
}

html .header-flyout__department-button--active { background: var(--color-co=
re-blue-10,#e6f1fc); }

html .header-flyout__department-button--active.rebranding, html .subcategor=
y-menu-columns.rebranding { background: rgb(233, 241, 254); }

html .org-hero-legal { text-wrap: nowrap; }

html .org-hero-heading { font-size: 1.25rem; line-height: 1.75rem; }

html [id=3D"__next-route-announcer__"] { display: none; }

html .org-hero-list-container { display: grid; list-style-position: inside;=
 list-style-type: disc; min-width: 320px; padding-left: 0px; padding-top: 4=
px; }

html .org-hero-list-grid-config { grid-template-columns: repeat(2, 1fr); mi=
n-width: 343px; }

html .org-hero-list-font-config { font-size: 14px; line-height: 20px; }

html .cta-link-container { max-width: 420px; }

html .hero-pov-cta-link:hover { text-decoration: underline; }

html .cta-list-item { font-size: 14px; line-height: 20px; }

html .org-hero-pov-bg { display: none; }

@media screen and (min-width: 600px) {
  html .org-hero-eyebrow { line-height: 1.25rem; }
  html .org-hero-sub-heading { line-height: 1.5rem; }
  html .org-hero-list-font-config { font-size: 18px; line-height: 24px; }
  html .org-hero-list-container { grid-template-columns: repeat(2, 1fr); mi=
n-width: 463px; }
  html .cta-list-item { font-size: 16px; line-height: 24px; }
}

@media screen and (min-width: 900px) {
  html .org-hero-pov-text-block { width: 42.5%; }
  html .org-hero-eyebrow { line-height: 1.5rem; }
  html .org-hero-heading { font-size: 1.5rem; line-height: 2.25rem; }
  html .org-hero-sub-heading { line-height: 1.75rem; }
  html .absolute-center { left: 50%; transform: translateX(-50%); }
  html .org-hero-list-font-config { font-size: 20px; line-height: 24px; }
  html .org-hero-pov-bg { display: block; }
}

@media screen and (min-width: 1200px) {
  html .org-hero-eyebrow { line-height: 1.75rem; }
  html .org-hero-heading { font-size: 2rem; line-height: 2.5rem; }
  html .org-hero-sub-heading { line-height: 2.25rem; }
  html .org-hero-list-font-config { font-size: 20px; line-height: 32px; }
}

@media screen and (min-width: 1440px) {
  html .org-hero-pov-text-block { padding-left: 2.5rem; padding-right: 2.5r=
em; }
}

@media screen and (min-width: 1660px) {
  html .legal-container { margin-bottom: 1rem; }
}

html .org-hero-legal { line-height: 1rem; }

html .container-1 { width: 85%; }

html .container-2 { width: 15%; }

@media screen and (max-width: 600px) {
  html .logo-dimension { height: 40px; width: 40px; }
}

@media screen and (min-width: 601px) {
  html .logo-dimension { height: 64px; width: 64px; }
}

.web-splash h2 { display: none; }

.web-splash .dweb-close { background-color: rgb(255, 255, 255); border-radi=
us: 50%; margin: 1.5rem; }

.web-splash .dweb-close:focus { border-color: rgba(0, 0, 0, 0); box-shadow:=
 none; outline: none; }

.web-splash div[role=3D"dialog"] { background-color: rgb(0, 30, 96); border=
-radius: 0px; padding: 0px; }

.web-splash div[role=3D"dialog"] > div { padding: 0px; }

.web-splash .benefit-img:nth-child(3n) { border-right: 0px; }

.mobile-modal div[data-focus-lock-disabled=3D"false"] > div { padding-top: =
145px; }

.mobile-modal h2 { display: none; }

.mobile-modal div[role=3D"dialog"] { background-color: rgb(0, 30, 96); bord=
er-radius: 1rem 1rem 0px 0px; }

.mobile-modal div[role=3D"dialog"] > div:nth-child(2) > div:first-child { p=
adding: 0px; }

.mobile-modal .overlayDiv { position: absolute; top: 0px; height: 145px; wi=
dth: 100%; z-index: 100; left: 0px; }

.mobile-modal .customClose { background-color: rgb(255, 255, 255); border-r=
adius: 50%; height: 36px; margin: 8px; width: 36px; position: relative; }

.mobile-modal .customClose svg { display: none; }

.mobile-modal .customClose:focus { border-color: rgba(0, 0, 0, 0); box-shad=
ow: none; outline: none; }

.mobile-modal .customClose::before { transform: rotate(45deg); }

.mobile-modal .customClose::after, .mobile-modal .customClose::before { pos=
ition: absolute; left: 17px; content: " "; height: 20px; width: 1.5px; back=
ground-color: rgb(0, 0, 0); top: 9px; }

.mobile-modal .customClose::after { transform: rotate(-45deg); }

html .oic-wrapper-small { background: rgb(255, 255, 255); border-radius: 0.=
5rem; box-shadow: rgba(0, 0, 0, 0.15) 0px 1px 2px 1px, rgba(0, 0, 0, 0.1) 0=
px -1px 2px 0px; box-sizing: border-box; height: 432px; width: 100%; overfl=
ow: hidden; }

html .bottom--4 { bottom: -3rem; }

@media screen and (min-width: 1200px) {
  html .bottom--4 { bottom: -4rem; }
}

.join-badge { border-radius: 10px; height: auto; line-height: 19px; padding=
: 1px 7px; text-align: center; width: auto; }

@media screen and (max-width: 600px) {
  .invite-via-url-dialog-title { margin-left: -2.5rem; }
}

html .print-only-card { display: none !important; }

@media print {
  html .no-print { display: none !important; }
  html .w-40-p { width: 40% !important; }
  html .print-only-card { display: block !important; }
  html .show-bg-green-print { background-color: rgb(234, 243, 230) !importa=
